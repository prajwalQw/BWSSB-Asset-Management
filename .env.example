# BWSSB Digital Twin Environment Configuration
# Copy this file to .env and configure secrets before production deployment.

# ==============================================================================
# Security & JWT Secrets
# ==============================================================================
# In production, SERVER REFUSES TO START if JWT_SECRET_KEY is left as default.
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Credentials (seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Bwssb@2026!Admin

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# ==============================================================================
# Server & Network Configuration
# ==============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEV_CORS_ORIGINS=["http://localhost:5180","http://127.0.0.1:5180","http://localhost:5173","http://127.0.0.1:5173"]

# ==============================================================================
# OT Bridge Safety Settings (Rule 4 Compliance)
# ==============================================================================
IGNOAPI_HOST=127.0.0.1
IGNOAPI_PORT=8899
# IGNOAPI_ALLOW_WRITES MUST BE false for passive read-only monitoring mode.
# When false, any write/control attempt will raise PermissionError.
IGNOAPI_ALLOW_WRITES=false

# ==============================================================================
# IoT Engine & Hydraulic Simulation
# ==============================================================================
IOT_ENABLED=true
SIM_TICK_SECONDS=1.0
