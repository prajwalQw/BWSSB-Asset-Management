  "alert_rules": [
    {
      "rule_id": "RULE-LEAK-01",
      "name": "DMA Minimum Night Flow Burst Anomaly",
      "category": "LEAK_DETECTION",
      "severity": "CRITICAL",
      "trigger_condition": "night_flow_observed > 1.35 * baseline_night_flow AND node_pressure_drop > 0.8",
      "recommendation_text": "Possible distribution main fracture. Dispatch acoustic leakage team to DMA Sector 4 (Basavanagudi corridor). Check isolation valve V-104.",
      "requires_human_approval": true
    },
    {
      "rule_id": "RULE-PUMP-PWR-01",
      "name": "Excess Pump Power Draw / Low Hydraulic Efficiency",
      "category": "PUMP_POWER",
      "severity": "HIGH",
      "trigger_condition": "active_power_kw > 1.15 * rated_power_kw AND discharge_flow < 0.90 * nominal_flow",
      "recommendation_text": "Pump power consumption exceeds rating curve by >15%. High risk of cavitation or impeller fouling at Tataguni Pump 1. Recommend shifting load to Standby Pump 3.",
      "requires_human_approval": true
    },
    {
      "rule_id": "RULE-PRESS-LOW-01",
      "name": "Low Consumer Pressure Deficit",
      "category": "PRESSURE_ANOMALY",
      "severity": "WARNING",
      "trigger_condition": "junction_pressure < 1.2 bar for > 15 consecutive minutes",
      "recommendation_text": "Consumer terminal pressure inadequate at high elevation nodes in High Grounds feeder. Recommend modulating PRV-03 or stepping up outlet booster.",
      "requires_human_approval": true
    },
    {
      "rule_id": "RULE-TANK-DRAIN-01",
      "name": "Balancing Reservoir Depletion Warning",
      "category": "STORAGE_LEVEL",
      "severity": "CRITICAL",
      "trigger_condition": "tank_level < 1.5m AND outflow > 1.2 * inflow",
      "recommendation_text": "Mount Joy GLR storage dropping towards critical reserve (35% remaining). Recommend requesting increased bulk allocation from Tataguni Pumping Head.",
      "requires_human_approval": true
    }
  ]
